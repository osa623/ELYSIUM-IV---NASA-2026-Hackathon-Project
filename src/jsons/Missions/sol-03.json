  "tasks": [
    {
      "id": "SOL03_TASK_01",
      "order": 1,
      "title": "Enter the Terrain Vehicle",
      "description": "Locate the rover at its existing position and enter using the ladder.",
      "trigger": "ladder",
      "interaction": "E",
      "completion_condition": "PLAYER_ENTERED_VEHICLE",
      "required": true
    },
    {
      "id": "SOL03_TASK_02",
      "order": 2,
      "title": "Review Previous Mission Records",
      "description": "Open Mission OS and review the saved mission logs, observations, soil investigation records and reports from SOL 01 and SOL 02.",
      "trigger": "Main_Screen_Trigger",
      "interaction": "E",
      "completion_condition": "SOL01_AND_SOL02_RECORDS_REVIEWED",
      "required": true,
      "data_sources": [
        "SOL_01",
        "SOL_02"
      ],
      "read_only": true
    },
    {
      "id": "SOL03_TASK_03",
      "order": 3,
      "title": "Inspect Water and Nutrition Systems",
      "description": "Inspect the remaining water supply and nutrition levels. Compare them with previous SOL records.",
