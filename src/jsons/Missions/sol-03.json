        "include_mountain_photographs": true,
        "include_research_observations": true,
        "include_tool_inspections": true,
        "include_navigation_records": true,
        "allow_user_written_report": true,
        "require_user_save": true,
        "persist_report": true
      }
    },
    {
      "id": "SOL03_TASK_13",
      "order": 13,
      "title": "Final Water and Nutrition Verification",
      "description": "Inspect the final water and nutrition condition and confirm the resource status. Record any anomaly if observed.",
      "trigger": "Water_and_nut_Trigger",
      "interaction": "E",
      "completion_condition": "FINAL_WATER_INSPECTION_CONFIRMED",
      "required": true,
      "display_fields": [
