      "interaction": "E",
      "completion_condition": "ENVIRONMENT_AND_OXYGEN_INSPECTED",
      "required": true,
      "display_fields": [
        "temperature_celsius",
        "surface_pressure_mbar",
        "wind_speed_mps",
        "wind_direction",
        "atmospheric_co2_percent",
        "atmospheric_o2_percent",
        "cabin_oxygen_percent",
        "cabin_co2_percent",
        "cabin_pressure_kpa",
        "air_filter_percent",
        "visibility_km",
        "dust_condition",
        "system_status"
      ],
      "save_inspection_record": true
    },
    {
      "id": "SOL03_TASK_05",
      "order": 5,
      "title": "Inspect Mission Tools",
      "description": "Review the available mission equipment and confirm that the required tools are available.",
      "trigger": "Tool_Section_Trigger",
      "interaction": "E",
      "completion_condition": "TOOLS_INSPECTED_AND_CONFIRMED",
      "required": true,
      "save_inspection_record": true
