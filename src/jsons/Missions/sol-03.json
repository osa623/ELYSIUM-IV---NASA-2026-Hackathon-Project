      "completion_condition": "ROVER_REACHED_SOL3_CHECKPOINT",
      "required": true,
      "navigation": {
        "enabled": true,
        "dynamic_beam": true,
        "destination_beacon": true,
        "visible_at_long_distance": true
      }
    },
    {
      "id": "SOL03_TASK_07",
      "order": 7,
      "title": "Capture Mountain Range Photographs",
      "description": "Exit the rover wearing the EVA suit. Use the EVA camera interface to photograph the SOL 03 mountain range.",
      "trigger": "Sol3_Checkpoint",
      "interaction": "E",
      "completion_condition": "MINIMUM_FOUR_SAVED_PHOTOGRAPHS",
      "required": true,
      "camera": {
        "enabled": true,
        "interface": "EVA_CAMERA",
        "capture_method": "SCREEN_RENDERER_CAPTURE",
        "capture_action": "RIGHT_MOUSE_BUTTON",
        "save_action": "SAVE_BUTTON",
        "delete_action": "DELETE_BUTTON",
        "exit_action": "BACKSPACE",
        "minimum_required_photos": 4,
        "maximum_allowed_photos": 6,
        "task_completes_at_minimum": true,
        "allow_additional_photos_after_minimum": true,
        "show_controls_on_screen": true,
        "show_live_camera_preview": true,
        "preserve_camera_view": true,
        "save_to_browser_storage": true,
        "persist_photo_blobs": true,
        "preserve_photo_metadata": true,
        "photo_metadata": [
          "photo_id",
          "capture_timestamp",
          "capture_position",
          "camera_heading_degrees",
          "camera_pitch_degrees",
          "camera_direction",
          "photo_blob_reference"
        ],
        "controls": {
          "right_mouse_button": "CAPTURE_PREVIEW",
          "save_button": "SAVE_PHOTO",
          "delete_button": "DELETE_SELECTED_PHOTO",
          "backspace": "EXIT_CAMERA"
        },
        "requirements": [
          "Do not count preview-only captures as saved photographs.",
          "Only successfully saved photographs count toward the required four.",
          "Allow the user to capture up to six photographs.",
          "Do not automatically exit the camera when the fourth photograph is saved.",
          "After at least four photographs have been saved, mark the photography task complete when the user exits using Backspace.",
          "Do not delete saved photographs when exiting the camera."
        ]
      }
    },
    {
      "id": "SOL03_TASK_08",
      "order": 8,
      "title": "Return to the Terrain Vehicle",
      "description": "Return to the rover with the saved mountain range photographs and enter using the ladder.",
      "trigger": "ladder",
      "interaction": "E",
      "completion_condition": "PLAYER_RETURNED_TO_VEHICLE",
