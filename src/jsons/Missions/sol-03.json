      "interaction": "E",
      "completion_condition": "WATER_AND_NUTRITION_INSPECTED",
      "required": true,
      "display_fields": [
        "water_level_percent",
        "nutrition_level_percent",
        "previous_sol_water_comparison",
        "previous_sol_nutrition_comparison",
        "system_status"
      ],
      "save_inspection_record": true
    },
    {
      "id": "SOL03_TASK_04",
      "order": 4,
      "title": "Inspect Environmental and Oxygen Systems",
      "description": "Inspect environmental conditions, oxygen systems, carbon dioxide levels, pressure and temperature.",
