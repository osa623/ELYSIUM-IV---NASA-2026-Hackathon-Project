      "interaction_key": "E",
      "requirements": [
        "VIEW_WATER_LEVEL",
        "VIEW_NUTRIENT_LEVEL",
        "RECORD_RESOURCE_READINGS",
        "SAVE_RESOURCE_LOG"
      ],
      "completion_condition": "RESOURCE_LOG_SAVED",
      "next_task": "SOL01_TASK_06"
    },
    {
      "id": "SOL01_TASK_06",
      "order": 6,
      "title": "Travel to the Second Checkpoint",
      "description": "Return to the driving station and navigate to the second observation checkpoint.",
      "trigger": "Driving_Section_Trigger",
      "interaction_key": "E",
      "destination": "2ndCheckpoint",
      "requirements": [
        "ENTER_DRIVING_MODE",
        "DRIVE_TO_CHECKPOINT",
        "STOP_AT_CHECKPOINT"
      ],
      "completion_condition": "ROVER_REACHED_2ND_CHECKPOINT",
      "on_complete": [
        "SET_TELEMETRY_PROFILE_checkpoint_02",
        "UPDATE_COMPUTER_SCREENS",
        "UNLOCK_SECOND_OBSERVATION"
      ],
      "next_task": "SOL01_TASK_07"
    },
    {
      "id": "SOL01_TASK_07",
      "order": 7,
      "title": "Record the Second Observation",
      "description": "Inspect the updated environmental readings and record the second observation in the mission operating system.",
