  "tasks": [
    {
      "id": "SOL02_TASK_01",
      "title": "Enter the Terrain Rover",
      "description": "Locate the rover near the SOL 02 starting point and enter through the ladder.",
      "type": "INTERACTION",
      "target": "ladder",
      "completion": {
        "required_action": "PRESS_E",
        "condition": "PLAYER_ENTERED_ROVER"
      },
      "next_task": "SOL02_TASK_02"
    },
    {
      "id": "SOL02_TASK_02",
      "title": "Review Previous Mission Records",
      "description": "Open the Mission OS and inspect the saved SOL 01 mission logs, completed tasks, observations and resource records.",
      "type": "MISSION_OS",
      "target": "Main_Screen_Trigger",
      "completion": {
        "required_action": "REVIEW_SOL_01_LOGS",
        "condition": "PREVIOUS_MISSION_RECORDS_REVIEWED"
      },
      "data_source": "SOL_01_PERSISTED_LOGS",
      "next_task": "SOL02_TASK_03"
    },
    {
      "id": "SOL02_TASK_03",
      "title": "Inspect BOTAN Nutrition System",
      "description": "Inspect the BOTAN nutrition system and verify its operational condition, nutrient availability and system status.",
      "type": "SYSTEM_INSPECTION",
      "target": "Water_and_nut_Trigger",
      "completion": {
        "required_action": "INSPECT_AND_CONFIRM",
        "condition": "BOTAN_SYSTEM_CONFIRMED"
      },
      "next_task": "SOL02_TASK_04"
    },
    {
      "id": "SOL02_TASK_04",
      "title": "Inspect Night-time Environment",
      "description": "Inspect the external Martian night environment, including temperature, surface pressure, wind speed, wind direction and visibility.",
      "type": "ENVIRONMENT_INSPECTION",
      "target": "Environment_Checking_Trigger",
      "completion": {
        "required_action": "INSPECT_ENVIRONMENT_AND_SAVE",
        "condition": "ENVIRONMENT_REPORT_SAVED"
      },
      "next_task": "SOL02_TASK_05"
    },
    {
      "id": "SOL02_TASK_05",
      "title": "Check Scientific Tools",
      "description": "Inspect the available soil sampling and environmental investigation tools and confirm the required equipment.",
      "type": "TOOL_CHECKLIST",
      "target": "Tool_Section_Trigger",
      "completion": {
        "required_action": "CHECK_REQUIRED_TOOLS_AND_CONFIRM",
        "condition": "REQUIRED_TOOLS_CONFIRMED"
      },
      "next_task": "SOL02_TASK_06"
    },
    {
      "id": "SOL02_TASK_06",
      "title": "Drive to Soil Investigation Checkpoint",
      "description": "Activate rover driving mode and follow the navigation beams to SOL 02 checkpoint.",
      "type": "DRIVING",
      "target": "Sol2_Checkpoint",
      "completion": {
        "required_action": "REACH_CHECKPOINT",
        "condition": "ROVER_REACHED_CHECKPOINT"
      },
      "next_task": "SOL02_TASK_07"
    },
    {
      "id": "SOL02_TASK_07",
      "title": "Collect Martian Soil Sample",
      "description": "Park the rover, exit wearing the EVA suit and travel to the soil investigation location. Collect a soil sample and record the soil observations.",
      "type": "OUTDOOR_SCIENTIFIC_INVESTIGATION",
      "target": "Sol2_Mission_investigation",
      "completion": {
        "required_action": "COLLECT_AND_SAVE_SOIL_SAMPLE",
        "condition": "SOIL_SAMPLE_COLLECTED_AND_OBSERVATIONS_SAVED"
      },
      "requires": [
        "SOL02_TASK_06"
      ],
      "next_task": "SOL02_TASK_08"
    },
    {
      "id": "SOL02_TASK_08",
      "title": "Return to the Terrain Rover",
      "description": "Return to the rover with the collected soil sample and re-enter the vehicle.",
      "type": "ROVER_ENTRY",
      "target": "ladder",
      "completion": {
        "required_action": "PRESS_E",
        "condition": "PLAYER_RETURNED_TO_ROVER_WITH_SAMPLE"
      },
      "next_task": "SOL02_TASK_09"
    },
    {
      "id": "SOL02_TASK_09",
      "title": "Place Soil Sample in the Tools Rack",
      "description": "Place the collected soil sample in the designated rack and confirm the sample transfer.",
      "type": "SAMPLE_TRANSFER",
      "target": "Tool_Section_Trigger",
      "completion": {
        "required_action": "PLACE_SAMPLE_AND_CONFIRM",
        "condition": "SAMPLE_RACK_TRANSFER_CONFIRMED"
      },
      "next_task": "SOL02_TASK_10"
    },
    {
      "id": "SOL02_TASK_10",
      "title": "Analyze Soil Sample in Mission OS",
      "description": "Open the Mission OS and inspect the automatically generated soil analysis results, scientific images and sample suitability assessment.",
      "type": "SCIENTIFIC_ANALYSIS",
      "target": "Main_Screen_Trigger",
      "completion": {
        "required_action": "REVIEW_ANALYSIS_AND_SAVE_REPORT",
        "condition": "SOIL_ANALYSIS_REVIEWED_AND_REPORT_SAVED"
      },
      "requires": [
        "SOL02_TASK_09"
      ],
      "next_task": "SOL02_TASK_11"
    },
    {
      "id": "SOL02_TASK_11",
      "title": "Drive to SOL 02 Final Destination",
      "description": "Follow the active navigation beams toward the SOL 02 finishing point.",
      "type": "DRIVING",
      "target": "Sol2_Finishing_Point",
      "completion": {
        "required_action": "REACH_FINISHING_POINT",
        "condition": "ROVER_REACHED_FINISHING_POINT"
      },
      "requires": [
        "SOL02_TASK_10"
      ],
      "next_task": "SOL02_TASK_12"
    },
    {
      "id": "SOL02_TASK_12",
      "title": "Complete SOL 02",
      "description": "Exit the rover at the final destination and confirm mission completion.",
      "type": "MISSION_COMPLETION",
      "target": "Sol2_Finishing_Point",
      "completion": {
        "required_action": "EXIT_ROVER_AND_PRESS_E",
        "condition": "SOL_02_ALL_TASKS_COMPLETED"
      },
      "next_mission": "SOL_03"
    }
  ],

  "soil_investigation": {
